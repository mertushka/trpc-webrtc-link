{
  "name": "@webrtc-node/trpc-webrtc-link",
  "version": "0.2.0",
  "description": "A complete tRPC v11 client link and server transport for WebRTC RTCDataChannels.",
  "keywords": [
    "trpc",
    "webrtc",
    "rtcdatachannel",
    "typescript",
    "subscriptions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webrtc-node/trpc-webrtc-link.git",
    "directory": "packages/trpc-webrtc-link"
  },
  "homepage": "https://github.com/webrtc-node/trpc-webrtc-link/tree/main/packages/trpc-webrtc-link#readme",
  "bugs": {
    "url": "https://github.com/webrtc-node/trpc-webrtc-link/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown --logLevel silent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:types": "npm run build && tsd"
  },
  "peerDependencies": {
    "@trpc/client": ">=11.17.0 <11.19.0",
    "@trpc/server": ">=11.17.0 <11.19.0"
  },
  "devDependencies": {
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@webrtc-node/webrtc": "^0.2.1",
    "superjson": "^2.2.6",
    "tsd": "^0.33.0",
    "tsdown": "^0.23.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsd": {
    "directory": "test-d"
  }
}
